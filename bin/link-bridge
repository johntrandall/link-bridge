#!/usr/bin/env python3
"""link-bridge: serve the bridge pages from this Mac, and manage the reveal:// handler.

    link-bridge serve [--port 5465] [--host 127.0.0.1]   run the local web server (brew services)
    link-bridge install-handler                           build the ~/Applications handler apps (Reveal in Finder, Jump to Session)
    link-bridge url <path> [--vault-setup]                print the local /reveal (or /vault-setup) link for a path
                                                          (http://link.localhost/... once the local front door is installed)
    link-bridge install-front-door                        Caddy on 127.0.0.1:80: http://link.localhost (root; sudo prompts)
    link-bridge doctor                                    is the server up, is the handler registered

GET /routes answers JSON {"version","routes","actions","registered"}: the consumer contract as data.
POST /act/<name>, for a name in ~/.config/link-bridge/actions.toml, runs that operator-registered
command with the request's named values (X-Link-Bridge: 1 and X-Link-Bridge-Token required; 0.1.12).
GET /healthz answers "link-bridge <version>" (directly and through the front door), so a status
line or script can tell the bridge from anything else on the port. POST /act/herdr-jump
{"session": uuid}, POST /act/herdr-workspace {"workspace": id} or {"label": text} and
POST /act/reveal {"path": p} (header X-Link-Bridge: 1) perform those actions on this Mac for a
browser that is not on it (iPad via the tailnet). POST /act/wake {"system", "seat"} runs
`watchbill resume <system> --seat <seat>` (0.1.15): the one action that starts an agent, so the
/wake page fires it only on a button press, on the Mac and off it alike.

The pages turn an https/http link into an app link (obsidian://, reveal://, obsidian-vault-setup://,
herdr-jump://) for places that only
make web links clickable. Serving them from 127.0.0.1 keeps every click on this machine, works
with no network, and needs no hosting. The target travels in the URL fragment, which the browser
never sends, so the server log never sees a note or file name.

Standard library only, so the Homebrew formula needs no virtualenv. Default port 5465 spells
LINK on a phone keypad; pick another with --port or LINK_BRIDGE_PORT if it clashes.
"""
import argparse
import http.server
import json
import os
import re
import socketserver
import subprocess
import sys
import urllib.parse

VERSION = "0.1.15"
DEFAULT_HOST = "127.0.0.1"
DEFAULT_PORT = 5465

HERE = os.path.dirname(os.path.realpath(__file__))
# In the repo: bin/../public. Installed by Homebrew: libexec/bin/../public (same shape).
ROOT = os.environ.get("LINK_BRIDGE_ROOT") or os.path.join(os.path.dirname(HERE), "public")
HANDLER_DIR = os.path.join(os.path.dirname(HERE), "handler")

# Same policy as public/_headers (which Cloudflare reads and a local server does not).
HEADERS = {
    "X-Robots-Tag": "noindex, nofollow",
    "Referrer-Policy": "no-referrer",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Content-Security-Policy": "default-src 'none'; script-src 'self'; style-src 'self'; "
                               "connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
    "Cache-Control": "no-cache",
}
# Routes without an extension serve the matching page, like Cloudflare's drop-trailing-slash.
ROUTES = {"/": "index.html", "/obsidian": "obsidian.html", "/reveal": "reveal.html",
          "/vault-setup": "vault-setup.html", "/herdr-jump": "herdr-jump.html",
          "/herdr-workspace": "herdr-workspace.html", "/herdr-owner": "herdr-owner.html",
          "/folder": "folder.html", "/wake": "wake.html"}


class Handler(http.server.SimpleHTTPRequestHandler):
    timeout = 15          # socket timeout: a client that stalls mid-body cannot hold a thread open
    server_version = "link-bridge"

    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=ROOT, **kwargs)

    def translate_path(self, path):
        clean = urllib.parse.urlsplit(path).path.rstrip("/") or "/"
        if clean in ROUTES:
            return os.path.join(ROOT, ROUTES[clean])
        return super().translate_path(path)

    def do_GET(self):
        # /healthz: one line a status line can probe to tell "link-bridge answers here"
        # from "something else answers on this port". Through the front door too.
        if urllib.parse.urlsplit(self.path).path.rstrip("/") == "/healthz":
            body = f"link-bridge {VERSION}\n".encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        # /routes: the consumer contract as data (version, page routes, actions), so a consumer
        # such as watchbill can tell whether a route it wants is installed here.
        if urllib.parse.urlsplit(self.path).path.rstrip("/") == "/routes":
            body = json.dumps({"version": VERSION,
                               "routes": sorted(r for r in ROUTES if r != "/"),
                               "actions": sorted(self.ACTIONS),
                               "registered": sorted(registered_actions())}).encode() + b"\n"
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        super().do_GET()

    def end_headers(self):
        for k, v in HEADERS.items():
            self.send_header(k, v)
        super().end_headers()

    def list_directory(self, path):
        self.send_error(404)
        return None

    # "Do it on the Mac": actions a page can request when the browser is not on this Mac
    # (an iPad reading the status line through Moshi, say) and so cannot follow a custom
    # scheme. Same gates as the handler apps: herdr_jump.py for a session id, reveal_decode.py
    # for a path; nothing from the request reaches a shell. Reachable only on loopback and,
    # via Tailscale Serve, the tailnet. The custom request header forces a CORS preflight,
    # which this server never answers, so a page on another origin cannot trigger an action.
    ACTIONS = {"/act/herdr-jump": "herdr-jump", "/act/herdr-workspace": "herdr-workspace",
               "/act/herdr-owner": "herdr-owner", "/act/reveal": "reveal",
               "/act/folder-obsidian": "folder-obsidian", "/act/wake": "wake"}

    def do_POST(self):
        route = urllib.parse.urlsplit(self.path).path.rstrip("/")
        registered = registered_actions() if route.startswith("/act/") else {}
        reg_name = route[len("/act/"):] if route.startswith("/act/") else ""
        if route not in self.ACTIONS and reg_name not in registered:
            self.send_error(405)
            return
        if self.headers.get("X-Link-Bridge") != "1":
            self._json(403, {"ok": False, "error": "missing X-Link-Bridge header"})
            return
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            length = -1
        if not 0 <= length <= 4096:
            # Checked before any read: a negative or absent-but-huge length must not reach rfile.read.
            self._json(400, {"ok": False, "error": "Content-Length must be 0..4096"})
            return
        try:
            body = json.loads(self.rfile.read(length) or b"{}")
            if not isinstance(body, dict):
                raise ValueError
        except (ValueError, TypeError):
            self._json(400, {"ok": False, "error": "body must be a JSON object"})
            return
        if route in self.ACTIONS:
            code, result = run_action(self.ACTIONS[route], body)
        else:
            code, result = run_registered(reg_name, registered[reg_name], body, self.headers.get("X-Link-Bridge-Token", ""),
                                          login=self.headers.get("Tailscale-User-Login", ""),
                                          client=self.client_address[0])
        self._json(code, result)

    def _json(self, code, obj):
        data = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def log_message(self, fmt, *args):
        # The fragment never arrives, so this is only method, path and status.
        sys.stderr.write("%s %s\n" % (self.log_date_time_string(), fmt % args))


class Server(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
    daemon_threads = True


UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")

# Registered actions (0.1.12): the operator of this Mac may register a command the bridge runs on
# POST /act/<name>. The request supplies named VALUES only; the command line is fixed in the
# config file, which only the operator writes, and nothing from the request is interpreted by a
# shell. Gates on every call: the X-Link-Bridge header (no cross-origin page can send it without a
# preflight this server never answers), a per-action secret in X-Link-Bridge-Token compared in
# constant time, each value a short string without control characters or a leading dash, the
# request body limited to 4 KiB, a timeout, and loopback or tailnet reachability only.
# Config: ~/.config/link-bridge/actions.toml ($LINK_BRIDGE_ACTIONS overrides), mode 0600:
#
#   [actions.personal-tracker-tap]
#   argv = ["/opt/homebrew/opt/python@3.14/bin/python3.14", "-E", "-s", "/Users/me/dev/personal-tracker/scripts/record_tap.py"]
#   params = ["date", "check", "button"]      # each becomes --<param> <value>, in this order
#   token = "<link-bridge token>"             # `link-bridge token` prints a fresh one
#   timeout = 20                              # seconds, optional
#   cwd = "/Users/me/dev/personal-tracker"    # optional
#   allow_logins = ["me@github"]              # optional: only these Tailscale logins (Tailscale-User-Login,
#                                             # set by Serve for untagged tailnet devices, client copies stripped)
#   allow_loopback = false                    # optional: with allow_logins, also admit calls made on this Mac
#   rate_per_minute = 10                      # optional: per action, 429 beyond it (default 10)
#
# Why the bridge and not a new daemon: it already runs on the Mac and already answers on the
# tailnet, and the port policy has no range for a tailnet-facing service here (personal-tracker
# intake, 2026-11-02). Why no GET: a GET with side effects is reachable from any page a tailnet
# device visits (an <img> is enough) and its query lands in logs; the POST gates cost Pushcut
# nothing, its background actions carry a method, headers and a body.
ACTIONS_CONFIG = os.environ.get("LINK_BRIDGE_ACTIONS") or os.path.expanduser("~/.config/link-bridge/actions.toml")
ACTION_NAME_RE = re.compile(r"[a-z0-9][a-z0-9-]{0,63}")
VALUE_MAX = 128


def registered_actions():
    """{name: spec} from the actions config, or {} when there is none or it is unreadable.
    A spec that is not well formed is dropped, and named on stderr, rather than run."""
    try:
        import tomllib
        with open(ACTIONS_CONFIG, "rb") as f:
            data = tomllib.load(f)
    except (OSError, ValueError, ImportError):
        return {}
    out = {}
    for name, spec in (data.get("actions") or {}).items():
        ok = (isinstance(spec, dict) and ACTION_NAME_RE.fullmatch(name)
              and isinstance(spec.get("argv"), list) and spec["argv"]
              and all(isinstance(a, str) and a for a in spec["argv"])
              and os.path.isabs(spec["argv"][0])
              and isinstance(spec.get("params"), list)
              and all(isinstance(p, str) and ACTION_NAME_RE.fullmatch(p) for p in spec["params"])
              and isinstance(spec.get("token"), str) and len(spec["token"]) >= 16
              and isinstance(spec.get("allow_logins", []), list)
              and all(isinstance(x, str) and x for x in spec.get("allow_logins", [])))
        if ok:
            out[name] = spec
        else:
            sys.stderr.write("link-bridge: actions.toml: [actions.%s] is not well formed; skipped\n" % name)
    return out


def clean_value(v):
    """A request value the runner will pass as one argument, or None when it is refused."""
    if not isinstance(v, str) or not v or len(v) > VALUE_MAX:
        return None
    if any(ord(c) < 0x20 or ord(c) == 0x7F for c in v) or v.startswith("-"):
        return None
    return v


_RATE = {}          # action name -> recent call times (monotonic seconds); one process, so one bucket
_RATE_LOCK = __import__("threading").Lock()


def rate_limited(name, per_minute):
    """True when this call would exceed per_minute calls in the last 60 s; records the call otherwise."""
    import time as _t
    now = _t.monotonic()
    with _RATE_LOCK:
        recent = [t for t in _RATE.get(name, []) if now - t < 60]
        if len(recent) >= per_minute:
            _RATE[name] = recent
            return True
        recent.append(now)
        _RATE[name] = recent
        return False


def run_registered(name, spec, body, token, login="", client=""):
    """Run one registered action for a request body; (http status, json).
    Gate order: token, caller identity (allow_logins), rate, values, run."""
    import hmac
    if not token or not hmac.compare_digest(token, spec["token"]):
        return 403, {"ok": False, "error": "bad or missing X-Link-Bridge-Token"}
    allowed = spec.get("allow_logins") or []
    if allowed:
        # Tailscale Serve sets Tailscale-User-Login for traffic from an untagged tailnet device and
        # strips any client-supplied copy; loopback callers and tagged devices carry none.
        if not login and spec.get("allow_loopback") and client in ("127.0.0.1", "::1"):
            pass
        elif login not in allowed:
            sys.stderr.write("link-bridge: %s refused: login %r not allowed\n" % (name, login or "(none)"))
            return 403, {"ok": False, "error": "this action is limited to named Tailscale logins"}
    if rate_limited(name, int(spec.get("rate_per_minute") or 10)):
        return 429, {"ok": False, "action": name, "error": "rate limit: try again in a minute"}
    args = list(spec["argv"])
    for param in spec["params"]:
        value = clean_value(body.get(param))
        if value is None:
            return 400, {"ok": False, "error": "%s is required: a short string, no control characters, no leading dash" % param}
        args += ["--" + param, value]
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=float(spec.get("timeout") or 20),
                           cwd=spec.get("cwd") or None,
                           env={"PATH": "/usr/bin:/bin:/opt/homebrew/bin", "HOME": os.path.expanduser("~"), "LANG": "en_US.UTF-8"})
    except subprocess.TimeoutExpired:
        return 504, {"ok": False, "action": name, "error": "timed out"}
    except OSError as e:
        return 500, {"ok": False, "action": name, "error": str(e)[:200]}
    if r.returncode == 0:
        return 200, {"ok": True, "action": name, "output": r.stdout.strip()[:2000]}
    return 400, {"ok": False, "action": name, "exit": r.returncode, "error": (r.stderr.strip() or r.stdout.strip())[:2000]}


def run_action(kind, body):
    """Perform a page-requested action on this Mac through the same gates as the handler apps."""
    if kind == "herdr-jump":
        session = str(body.get("session", "")).lower()
        if not UUID_RE.fullmatch(session):
            return 400, {"ok": False, "error": "session must be one uuid"}
        script = os.path.join(HANDLER_DIR, "herdr_jump.py")
        r = subprocess.run([sys.executable, "-I", script, f"herdr-jump://session/{session}"],
                           capture_output=True, text=True, timeout=30,
                           env={**os.environ, "HERDR_BIN_PATH": os.environ.get("HERDR_BIN_PATH", "/opt/homebrew/bin/herdr")})
        if r.returncode == 0:
            return 200, {"ok": True, "action": "herdr-jump", "session": session}
        return (404 if r.returncode == 1 else 400), {"ok": False, "error": "session not live" if r.returncode == 1 else "refused"}
    if kind == "herdr-owner":
        session = str(body.get("session", "")).lower()
        if not UUID_RE.fullmatch(session):
            return 400, {"ok": False, "error": "session must be one uuid"}
        script = os.path.join(HANDLER_DIR, "herdr_jump.py")
        r = subprocess.run([sys.executable, "-I", script, f"herdr-jump://owner/{session}"],
                           capture_output=True, text=True, timeout=45,
                           env={**os.environ, "HERDR_BIN_PATH": os.environ.get("HERDR_BIN_PATH", "/opt/homebrew/bin/herdr")})
        if r.returncode == 0:
            return 200, {"ok": True, "action": "herdr-owner", "session": session}
        return (404 if r.returncode == 1 else 400), {"ok": False, "error": "no live seat owner" if r.returncode == 1 else "refused"}
    if kind == "herdr-workspace":
        # One of {"workspace": "<id>"} or {"label": "<tab-bar label>"}; the handler's own parser is
        # the gate (ids wXX, labels <= 80 chars without control characters), nothing reaches a shell.
        workspace = str(body.get("workspace", ""))
        label = str(body.get("label", ""))
        if workspace:
            url = f"herdr-jump://workspace/{workspace}"
        elif label:
            url = "herdr-jump://workspace/label/" + urllib.parse.quote(label, safe="")
        else:
            return 400, {"ok": False, "error": "workspace or label required"}
        script = os.path.join(HANDLER_DIR, "herdr_jump.py")
        r = subprocess.run([sys.executable, "-I", script, url], capture_output=True, text=True, timeout=30,
                           env={**os.environ, "HERDR_BIN_PATH": os.environ.get("HERDR_BIN_PATH", "/opt/homebrew/bin/herdr")})
        if r.returncode == 0:
            return 200, {"ok": True, "action": "herdr-workspace", "workspace": workspace or None, "label": label or None}
        return (404 if r.returncode == 1 else 400), {"ok": False, "error": "workspace not found" if r.returncode == 1 else "refused"}
    if kind == "folder-obsidian":
        path = str(body.get("path", ""))
        if not path or any(ord(c) < 0x20 or ord(c) == 0x7F for c in path):
            return 400, {"ok": False, "error": "path required"}
        url = "reveal://obsidian?path=" + urllib.parse.quote(path, safe="")
        r = subprocess.run([sys.executable, "-I", os.path.join(HANDLER_DIR, "reveal_decode.py"), url],
                           capture_output=True, text=True, timeout=10)
        real = r.stdout.strip()
        if r.returncode != 0 or not real:
            return 404, {"ok": False, "error": "path refused or missing"}
        r = subprocess.run([sys.executable, "-I", os.path.join(HANDLER_DIR, "reveal_obsidian.py"), real],
                           capture_output=True, text=True, timeout=45)
        if r.returncode == 2:
            return 404, {"ok": False, "error": "not inside a registered Obsidian vault"}
        return 200, {"ok": True, "action": "folder-obsidian", "path": real, "note": r.returncode == 0}
    if kind == "reveal":
        path = str(body.get("path", ""))
        if not path or any(ord(c) < 0x20 or ord(c) == 0x7F for c in path):
            return 400, {"ok": False, "error": "path required"}
        script = os.path.join(HANDLER_DIR, "reveal_decode.py")
        url = "reveal://reveal?path=" + urllib.parse.quote(path, safe="")
        r = subprocess.run([sys.executable, "-I", script, url], capture_output=True, text=True, timeout=10)
        real = r.stdout.strip()
        if r.returncode != 0 or not real:
            return 404, {"ok": False, "error": "path refused or missing"}
        subprocess.run(["/usr/bin/open", "-R", real], capture_output=True, timeout=10)
        return 200, {"ok": True, "action": "reveal", "path": real}
    if kind == "wake":
        return run_wake(body)
    return 400, {"ok": False, "error": "unknown action"}


# /act/wake (0.1.15; asked by watchbill 0.10.95, D12 §8, intake 2026-11-05): `_seats.md` in the
# cross-system queue vault lists every asleep lead designer and steward with the command that wakes
# it, dead text in Obsidian; /wake#<system>/<seat> makes the row one click. The bridge runs the fixed
# argv [watchbill, resume, <system>, --seat, <seat>] with the two names as plain arguments, each a
# slug (no shell, no leading dash, 64 characters at most). watchbill itself is the judge of the
# rest: it refuses an unknown system, a seat that is not asleep (live or never seen), and a session
# past its hard line, and it spawns the seat in its own herdr workspace through herdr-lifecycle.
# Why no herdr-jump://wake scheme form: a registered scheme can be emitted by any page or app
# and fires with no page in between; this action starts an agent, so the only way in is the page's
# button or a same-origin POST that carries the X-Link-Bridge header.
SLUG_RE = re.compile(r"[a-z0-9][a-z0-9._-]{0,63}", re.IGNORECASE)
WATCHBILL_BIN = os.environ.get("WATCHBILL_BIN_PATH") or os.path.expanduser("~/.local/bin/watchbill")
# brew services start the server with a bare PATH; watchbill and the tools it calls (herdr,
# herdr-lifecycle, claude) live in these.
TOOL_PATH = ":".join([os.path.expanduser("~/.local/bin"), "/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin"])


def run_wake(body):
    system = str(body.get("system", ""))
    seat = str(body.get("seat", "")) or "lead-designer"
    if not SLUG_RE.fullmatch(system):
        return 400, {"ok": False, "error": "system must be one watchbill slug"}
    if not SLUG_RE.fullmatch(seat):
        return 400, {"ok": False, "error": "seat must be one watchbill slug"}
    if not (os.path.isfile(WATCHBILL_BIN) and os.access(WATCHBILL_BIN, os.X_OK)):
        return 501, {"ok": False, "error": "watchbill is not installed on this Mac (WATCHBILL_BIN_PATH)"}
    argv = [WATCHBILL_BIN, "resume", system.lower(), "--seat", seat.lower()]
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=120,
                           env={**os.environ, "PATH": TOOL_PATH + ":" + os.environ.get("PATH", "")})
    except subprocess.TimeoutExpired:
        return 504, {"ok": False, "action": "wake", "error": "watchbill resume did not finish in 120 s"}
    said = (r.stdout.strip() or r.stderr.strip())[:2000]
    if r.returncode == 0:
        return 200, {"ok": True, "action": "wake", "system": system.lower(), "seat": seat.lower(), "output": said}
    # 1: no such system, or nothing of that name is asleep (live seats included); 3: past its hard line.
    return (409 if r.returncode in (1, 3) else 400), {"ok": False, "action": "wake", "exit": r.returncode, "error": said}


def cmd_serve(args):
    if not os.path.isfile(os.path.join(ROOT, "reveal.html")):
        sys.exit(f"link-bridge: no pages at {ROOT} (set LINK_BRIDGE_ROOT)")
    with Server((args.host, args.port), Handler) as httpd:
        sys.stderr.write(f"link-bridge: serving {ROOT} on http://{args.host}:{args.port}/\n")
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            pass
    return 0


def cmd_install_handler(_args):
    script = os.path.join(HANDLER_DIR, "install.sh")
    if not os.path.isfile(script):
        sys.exit(f"link-bridge: handler installer not found at {script}")
    return subprocess.call(["/bin/sh", script])


def short_path(path):
    """The fragment form of a path: home-relative when under the home folder, else absolute.
    Only / is left unencoded, so the link stays readable and a terminal's URL scanner keeps
    it whole (spaces and the like are percent-encoded)."""
    path = os.path.abspath(path)
    home = os.path.expanduser("~")
    if path == home:
        return ""
    if path.startswith(home + os.sep):
        path = path[len(home) + 1:]
    return urllib.parse.quote(path, safe="/")


FRONT_DOOR_NAME = os.environ.get("LINK_BRIDGE_NAME", "link.localhost")


def front_door_configured():
    """True when /etc/hosts carries the front-door name (admin-technical
    setup/macos/local-front-door installs Caddy on 127.0.0.1:80 and adds the
    line), so links can drop the port. Chrome resolves *.localhost by itself,
    but Safari and curl need the hosts line, so that is the signal."""
    try:
        with open("/etc/hosts", encoding="utf-8", errors="ignore") as f:
            return any(line.split()[1:2] == [FRONT_DOOR_NAME]
                       for line in f if line.strip() and not line.startswith("#"))
    except OSError:
        return False


def link_base(args):
    if os.environ.get("LINK_BRIDGE_URL_BASE"):
        return os.environ["LINK_BRIDGE_URL_BASE"].rstrip("/")
    if front_door_configured():
        return f"http://{FRONT_DOOR_NAME}"
    return f"http://{args.host}:{args.port}"


def cmd_install_front_door(_args):
    script = os.path.join(os.path.dirname(HERE), "frontdoor", "install.sh")
    if not os.path.isfile(script):
        sys.exit(f"link-bridge: front-door installer not found at {script}")
    if not os.path.exists("/opt/homebrew/opt/caddy/bin/caddy"):
        sys.exit("link-bridge: install Caddy first: brew install caddy")
    return subprocess.call(["/bin/sh", script])


def cmd_url(args):
    page = "vault-setup" if args.vault_setup else "reveal"
    print(f"{link_base(args)}/{page}#" + short_path(args.path))
    return 0


def cmd_token(_args):
    """Print a fresh secret for an [actions.<name>] token (48 hex chars)."""
    import secrets
    print(secrets.token_hex(24))
    return 0


def cmd_doctor(args):
    import urllib.request
    ok = True
    url = f"http://{args.host}:{args.port}/reveal"
    try:
        with urllib.request.urlopen(url, timeout=3) as r:
            print(f"server:  ok ({r.status} {url})")
    except Exception as e:  # noqa: BLE001
        print(f"server:  NOT answering at {url} ({e}); run `brew services start link-bridge`")
        ok = False
    if front_door_configured():
        name_url = f"http://{FRONT_DOOR_NAME}/reveal"
        try:
            with urllib.request.urlopen(name_url, timeout=3) as r:
                print(f"front door: ok ({r.status} {name_url})")
        except Exception as e:  # noqa: BLE001
            print(f"front door: {FRONT_DOOR_NAME} is in /etc/hosts but {name_url} failed ({e}); "
                  "sudo launchctl print system/com.johnrandall.local-front-door")
            ok = False
    else:
        print(f"front door: not configured (links carry :{args.port}); optional, see "
              "admin-technical setup/macos/local-front-door")
    for app_name, scheme in (("Reveal in Finder", "reveal://"), ("Jump to Session", "herdr-jump://")):
        app = os.path.expanduser(f"~/Applications/{app_name}.app")
        if os.path.isdir(app):
            print(f"handler: ok ({scheme} -> {app})")
        else:
            print(f"handler: {app_name}.app missing ({scheme}); run `link-bridge install-handler`")
            ok = False
    return 0 if ok else 1


def main(argv=None):
    ap = argparse.ArgumentParser(prog="link-bridge", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name, fn in (("serve", cmd_serve), ("url", cmd_url), ("doctor", cmd_doctor)):
        p = sub.add_parser(name)
        p.add_argument("--host", default=os.environ.get("LINK_BRIDGE_HOST", DEFAULT_HOST))
        p.add_argument("--port", type=int, default=int(os.environ.get("LINK_BRIDGE_PORT", DEFAULT_PORT)))
        if name == "url":
            p.add_argument("path")
            p.add_argument("--vault-setup", action="store_true",
                           help="the /vault-setup link (open or create the Obsidian vault) instead of /reveal")
        p.set_defaults(fn=fn)
    sub.add_parser("token", help="print a fresh secret for a registered action (actions.toml)").set_defaults(fn=cmd_token)
    sub.add_parser("install-handler").set_defaults(fn=cmd_install_handler)
    sub.add_parser("install-front-door").set_defaults(fn=cmd_install_front_door)
    args = ap.parse_args(argv)
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
